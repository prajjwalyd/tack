<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tack's logic: no Windows APIs and no UI, so it is plain to test. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The board.json text encoder overrides methods that take pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tack.Core.Tests" />
  </ItemGroup>

</Project>
