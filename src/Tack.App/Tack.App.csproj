<Project Sdk="Microsoft.NET.Sdk">

  <!-- The app: WinUI 3, unpackaged, carrying its own Windows App SDK, published with Native AOT. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>Tack.App</RootNamespace>
    <AssemblyName>Tack</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icons\icon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Despite the name, needed unpackaged too: without it publish leaves out
         the app's .pri, and no XAML page loads. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.cs is the entry point: it checks for another Tack before any UI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="..\..\assets\icons\icon.ico" Link="Assets\Tack.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The tray's glyphs, light and dark, at each size the tray draws (Shell/TrayGlyph in Tack.Windows). -->
    <Content Include="..\..\assets\icons\tray-*.png" Link="Assets\Tray\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The print art (scripts/board-assets), read from beside the exe. -->
    <Content Include="..\..\assets\board\*.png" Link="Assets\Board\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The board's felt wool and the frame's brushed grain (Pinboard/Chrome). -->
    <Content Include="..\..\assets\felt\*.png" Link="Assets\felt\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\board\chrome\*.png" Link="Assets\Board\chrome\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The board's tock and pop (scripts/sounds/render.cs writes them), played from memory. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\board\sounds\*.wav" LogicalName="Tack.Sounds.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The phone board's page (Phone/PhonePageFiles), served from memory to the person's devices. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\phone\index.html;..\..\assets\phone\phone.js;..\..\assets\phone\phone.css;..\..\assets\phone\icon.png"
                      LogicalName="Tack.Phone.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tack.Core\Tack.Core.csproj" />
    <ProjectReference Include="..\Tack.Windows\Tack.Windows.csproj" />
  </ItemGroup>

</Project>
