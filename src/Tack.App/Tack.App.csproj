<Project Sdk="Microsoft.NET.Sdk">

  <!-- The app: WinUI 3, unpackaged, carrying its own Windows App SDK, published with Native AOT. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>Tack.App</RootNamespace>
    <AssemblyName>Tack</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Tack.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Despite the name, needed unpackaged too: without it publish leaves out
         the app's .pri, and no XAML page loads. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.cs is the entry point: it checks for another Tack before any UI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <!-- Read from beside the exe: the icon, the tray's glyphs, the print art, the felt and the frame's grain.
         The scripts under scripts/ make them. -->
    <Content Include="Assets\Tack.ico;Assets\**\*.png" Exclude="Assets\Phone\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Played and served from memory: the board's tock and pop, and the phone board's page. -->
    <EmbeddedResource Include="Assets\Sounds\*.wav" LogicalName="Tack.Sounds.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Phone\*" LogicalName="Tack.Phone.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tack.Core\Tack.Core.csproj" />
    <ProjectReference Include="..\Tack.Windows\Tack.Windows.csproj" />
  </ItemGroup>

</Project>
