<?xml version="1.0" encoding="utf-8"?>
<!-- The Settings window: a title that stays and, under it, either the list of groups or the phone
     page, each scrolling on its own. The window can be short: it sits under the board. -->
<Window
    x:Class="Tack.App.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sections="using:Tack.App.Settings.Sections"
    xmlns:pages="using:Tack.App.Settings.Pages"
    Title="Tack settings">
    <!-- Mica, as Windows Settings has: the window takes a tint of the wallpaper behind it. -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The title, WinUI's breadcrumb at Windows Settings' size: "Settings", or "Settings › Use on your phone"
             on the phone page, where the first part is the way back. -->
        <BreadcrumbBar x:Name="Crumbs" Margin="20,10,20,8" AutomationProperties.Name="Settings pages">
            <BreadcrumbBar.Resources>
                <x:Double x:Key="BreadcrumbBarItemThemeFontSize">28</x:Double>
                <x:Double x:Key="BreadcrumbBarChevronFontSize">14</x:Double>
                <Thickness x:Key="BreadcrumbBarChevronPadding">11,0</Thickness>
                <FontWeight x:Key="BreadcrumbBarItemFontWeight">SemiBold</FontWeight>
                <!-- The way back and the chevron are grey, brightening when pointed at; the page itself is white. -->
                <StaticResource x:Key="BreadcrumbBarForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
                <StaticResource x:Key="BreadcrumbBarNormalForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
                <StaticResource x:Key="BreadcrumbBarHoverForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            </BreadcrumbBar.Resources>
        </BreadcrumbBar>
        <!-- A hairline under the title once something is scrolled beneath it. -->
        <Rectangle x:Name="HeadLine" Style="{StaticResource SettingsDivider}" VerticalAlignment="Bottom" Opacity="0" />

        <ScrollViewer x:Name="ListScroll" Grid.Row="1">
            <StackPanel x:Name="List" Spacing="20" Padding="20,4,20,24">
                <sections:PhoneCard x:Name="PhoneCardSection" />
                <sections:GeneralSection x:Name="GeneralSection" />
                <sections:SpeedSection x:Name="SpeedSection" />
                <sections:AppearanceSection x:Name="AppearanceSection" />
                <sections:ShortcutsSection x:Name="ShortcutsSection" />
                <sections:UpdatesSection x:Name="UpdatesSection" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="PhoneScroll" Grid.Row="1" Visibility="Collapsed">
            <pages:PhonePage x:Name="PhonePage" Margin="20,4,20,24" />
        </ScrollViewer>

        <!-- The window's spoken status line: what a change did, for a screen reader. Never seen. -->
        <TextBlock x:Name="Live" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" />
    </Grid>
</Window>
