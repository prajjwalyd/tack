<?xml version="1.0" encoding="utf-8"?>
<!-- The Settings window: a title that stays and, under it, either the list of groups or the phone
     page, each scrolling on its own. The window can be short: it sits under the board. -->
<Window
    x:Class="Tack.App.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sections="using:Tack.App.Settings.Sections"
    xmlns:pages="using:Tack.App.Settings.Pages"
    Title="Tack settings">
    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- On the phone page the title reads "Settings › Use on your phone", the first part the way back. -->
        <StackPanel Orientation="Horizontal" Padding="20,14,20,8">
            <HyperlinkButton x:Name="Back" Content="Settings" Visibility="Collapsed" Padding="6,0" Margin="-6,0,0,0" VerticalAlignment="Center"
                             FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             AutomationProperties.Name="Back to Settings" />
            <TextBlock x:Name="Crumb" Text="&#x203A;" Visibility="Collapsed" Margin="6,0" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"
                       Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="PageTitle" Text="Settings" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"
                       AutomationProperties.HeadingLevel="Level1" />
        </StackPanel>
        <!-- A hairline under the title once something is scrolled beneath it. -->
        <Rectangle x:Name="HeadLine" Style="{StaticResource SettingsDivider}" VerticalAlignment="Bottom" Opacity="0" />

        <ScrollViewer x:Name="ListScroll" Grid.Row="1">
            <StackPanel x:Name="List" Spacing="20" Padding="20,4,20,24">
                <sections:PhoneCard x:Name="PhoneCardSection" />
                <sections:GeneralSection x:Name="GeneralSection" />
                <sections:SpeedSection x:Name="SpeedSection" />
                <sections:AppearanceSection x:Name="AppearanceSection" />
                <sections:ShortcutsSection x:Name="ShortcutsSection" />
                <sections:UpdatesSection x:Name="UpdatesSection" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="PhoneScroll" Grid.Row="1" Visibility="Collapsed">
            <pages:PhonePage x:Name="PhonePage" Margin="20,4,20,24" />
        </ScrollViewer>

        <!-- The window's spoken status line: what a change did, for a screen reader. Never seen. -->
        <TextBlock x:Name="Live" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" />
    </Grid>
</Window>
