<?xml version="1.0" encoding="utf-8"?>
<!-- The look every part of the Settings window shares: titled groups of cards, rows inside a card,
     the hairline between rows, and the shortcut field's keycaps. Merged into the app's resources,
     so each section's own XAML can use them. Colours are the system's theme resources, so light,
     dark and high contrast follow Windows. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A group's title, above its cards. -->
    <Style x:Key="SettingsGroupTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="2,0,0,8" />
    </Style>

    <!-- A line of explanation under a group's title. -->
    <Style x:Key="SettingsGroupDescription" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Margin" Value="2,-2,2,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A card: one rounded block of rows. -->
    <Style x:Key="SettingsCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- A row of a card: its text on the left, its control on the right. -->
    <Style x:Key="SettingsRow" TargetType="Grid">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <!-- A card that is one block: a description and its control. -->
    <Style x:Key="SettingsBlock" TargetType="StackPanel">
        <Setter Property="Padding" Value="16,12,16,16" />
        <Setter Property="Spacing" Value="12" />
    </Style>

    <Style x:Key="SettingsRowTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsRowDescription" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- What a row says at its right: a version, the name of a choice. -->
    <Style x:Key="SettingsRowValue" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The hairline between two rows of a card. -->
    <Style x:Key="SettingsDivider" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    </Style>

    <!-- A key of a shortcut, as on a keyboard seen from above: a lighter top, a firmer base. -->
    <Style x:Key="SettingsKeycap" TargetType="Border">
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{ThemeResource ControlSolidFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="SettingsKeycapText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Words in a shortcut field: "Press a shortcut…" while it listens. -->
    <Style x:Key="SettingsFieldNote" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- "Off" in a shortcut field. -->
    <Style x:Key="SettingsFieldOff" TargetType="TextBlock" BasedOn="{StaticResource SettingsFieldNote}">
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- The ring round a shortcut field: none at rest, the accent colour while it listens, the same size either way. -->
    <Style x:Key="SettingsFieldRing" TargetType="Border">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="SettingsFieldRingListening" TargetType="Border" BasedOn="{StaticResource SettingsFieldRing}">
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    </Style>
</ResourceDictionary>
