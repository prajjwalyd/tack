<?xml version="1.0" encoding="utf-8"?>
<!-- A card with an on/off switch: its icon, title and description on the left, the switch on the right. -->
<UserControl
    x:Class="Tack.App.Settings.Controls.SwitchRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource SettingsCard}">
        <Grid Style="{StaticResource SettingsRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="Icon" Style="{StaticResource SettingsRowIcon}" Visibility="Collapsed" />
            <StackPanel x:Name="Texts" Grid.ColumnSpan="2" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource SettingsRowTitle}" />
                <TextBlock x:Name="DescriptionText" Style="{StaticResource SettingsRowDescription}" Visibility="Collapsed" />
            </StackPanel>
            <ToggleSwitch x:Name="Switch" Grid.Column="2" MinWidth="0" OnContent="On" OffContent="Off"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
