<?xml version="1.0" encoding="utf-8"?>
<!-- A row of a card with an on/off switch: its title and description on the left, the switch on the right. -->
<UserControl
    x:Class="Tack.App.Settings.Controls.SwitchRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource SettingsRow}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Style="{StaticResource SettingsRowTitle}" />
            <TextBlock x:Name="DescriptionText" Style="{StaticResource SettingsRowDescription}" Visibility="Collapsed" />
        </StackPanel>
        <ToggleSwitch x:Name="Switch" Grid.Column="1" MinWidth="0" OnContent="On" OffContent="Off"
                      HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>
</UserControl>
