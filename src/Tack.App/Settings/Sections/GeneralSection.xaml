<?xml version="1.0" encoding="utf-8"?>
<!-- General: the switches the tray's menu has too. -->
<UserControl
    x:Class="Tack.App.Settings.Sections.GeneralSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tack.App.Settings.Controls">
    <StackPanel>
        <TextBlock Text="General" Style="{StaticResource SettingsGroupTitle}" AutomationProperties.HeadingLevel="Level2" />
        <StackPanel Spacing="4">
            <controls:SwitchRow x:Name="Sound" Glyph="&#xE767;" Title="Sound" Description="A soft sound when a snip is pinned." />
            <controls:SwitchRow x:Name="EdgeReveal" Glyph="&#xE74A;" Title="Reveal at top edge"
                                Description="Move the pointer to the top of the screen to show the board." />
            <controls:SwitchRow x:Name="Autostart" Glyph="&#xE7E8;" Title="Start with Windows" Description="Open Tack when you sign in." />
        </StackPanel>
    </StackPanel>
</UserControl>
