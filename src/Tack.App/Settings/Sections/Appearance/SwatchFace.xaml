<?xml version="1.0" encoding="utf-8"?>
<!-- What a swatch shows: a 32 px picture with a hairline edge, a ring 2 px out and a check mark when
     it is the one chosen, and its name under it. The picture itself is drawn from code. -->
<UserControl
    x:Class="Tack.App.Settings.Sections.Appearance.SwatchFace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SwatchEdgeBrush" Color="#38000000" />
                    <SolidColorBrush x:Key="SwatchRingBrush" Color="#E4000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SwatchEdgeBrush" Color="#47FFFFFF" />
                    <SolidColorBrush x:Key="SwatchRingBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SwatchEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SwatchRingBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel x:Name="Body" Spacing="8" HorizontalAlignment="Center">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ChoiceStates">
                <VisualState x:Name="UnchosenState" />
                <VisualState x:Name="ChosenState">
                    <VisualState.Setters>
                        <Setter Target="Ring.Visibility" Value="Visible" />
                        <Setter Target="Mark.Visibility" Value="Visible" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid Width="40" Height="40">
            <Border x:Name="Ring" BorderThickness="2" CornerRadius="20" BorderBrush="{ThemeResource SwatchRingBrush}" Visibility="Collapsed" />
            <Border x:Name="Edge" Width="34" Height="34" BorderThickness="1" CornerRadius="17" BorderBrush="{ThemeResource SwatchEdgeBrush}" />
            <Grid x:Name="Picture" Width="32" Height="32" />
            <Grid x:Name="Mark" Width="16" Height="16" Visibility="Collapsed">
                <Path x:Name="Glow" Data="M3.5,8.4 L6.5,11.4 L12.5,5" StrokeThickness="3.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <Path x:Name="Check" Data="M3.5,8.4 L6.5,11.4 L12.5,5" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Grid>
        </Grid>
        <TextBlock x:Name="Label" FontSize="10.5" LineHeight="14" HorizontalAlignment="Center" TextLineBounds="Full"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw" />
    </StackPanel>
</UserControl>
