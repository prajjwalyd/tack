<?xml version="1.0" encoding="utf-8"?>
<!-- Updates: this version, the check-when-Tack-starts switch, and a row saying how updates stand
     with the one button that fits, a progress bar while it downloads, and the release notes. -->
<UserControl
    x:Class="Tack.App.Settings.Sections.UpdatesSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tack.App.Settings.Controls">
    <UserControl.Resources>
        <!-- The release notes open in place, as a quiet line inside the card rather than a card of their own.
             The expander's own padding and height come from its template, so the rest is set on it. -->
        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
        <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Updates" Style="{StaticResource SettingsGroupTitle}" AutomationProperties.HeadingLevel="Level2" />
        <StackPanel Spacing="4">
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource SettingsRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE946;" Style="{StaticResource SettingsRowIcon}" />
                    <TextBlock Grid.Column="1" Text="Tack" Style="{StaticResource SettingsRowTitle}" VerticalAlignment="Center" />
                    <TextBlock x:Name="VersionText" Grid.Column="2" Style="{StaticResource SettingsRowValue}" IsTextSelectionEnabled="True" />
                </Grid>
            </Border>
            <controls:SwitchRow x:Name="CheckSwitch" Glyph="&#xE823;" Title="Check for updates when Tack starts"
                                Description="Tack looks for a new version once each time it starts." />
            <Border Style="{StaticResource SettingsCard}">
                <Grid x:Name="StatusRow" Style="{StaticResource SettingsRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <FontIcon Glyph="&#xE895;" Style="{StaticResource SettingsRowIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="Headline" Style="{StaticResource SettingsRowTitle}" />
                        <TextBlock x:Name="Sub" Style="{StaticResource SettingsRowDescription}" Visibility="Collapsed" />
                    </StackPanel>
                    <Button x:Name="ActionButton" Grid.Column="2" MinWidth="120" VerticalAlignment="Center" IsEnabled="False" />
                    <ProgressBar x:Name="Meter" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,4" Maximum="100" Visibility="Collapsed"
                                 AutomationProperties.Name="Download progress" />
                    <Expander x:Name="Notes" Grid.Row="2" Grid.ColumnSpan="3" Margin="-16,4,0,0" Padding="16,0,0,4"
                              MinHeight="32" Background="Transparent" BorderBrush="Transparent"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                        <Expander.Header>
                            <TextBlock x:Name="NotesTitle" Style="{StaticResource BodyTextBlockStyle}" FontSize="13"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Expander.Header>
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
                            <ScrollViewer x:Name="NotesScroll" MaxHeight="132" Padding="10,8">
                                <TextBlock x:Name="NotesText" Style="{StaticResource SettingsRowDescription}" IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </Border>
                    </Expander>
                </Grid>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
