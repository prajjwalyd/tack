<?xml version="1.0" encoding="utf-8"?>
<!-- An allowed device: its NetBird name, when it was allowed, and Remove. -->
<UserControl
    x:Class="Tack.App.Settings.Pages.Phone.DeviceRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource SettingsRow}" Padding="16,6,8,6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="NameText" Style="{StaticResource SettingsRowTitle}" />
            <TextBlock x:Name="WhenText" Style="{StaticResource SettingsRowDescription}" />
        </StackPanel>
        <HyperlinkButton x:Name="Remove" Grid.Column="1" Content="Remove" VerticalAlignment="Center" />
    </Grid>
</UserControl>
