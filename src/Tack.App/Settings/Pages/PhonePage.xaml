<?xml version="1.0" encoding="utf-8"?>
<!-- The phone page of Settings, shown in place of the list: a device's request (if any), what the phone
     board does, the switch, the body (what NetBird needs, or the QR code and address), and the allowed devices. -->
<UserControl
    x:Class="Tack.App.Settings.Pages.PhonePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tack.App.Settings.Controls"
    xmlns:phone="using:Tack.App.Settings.Pages.Phone">
    <StackPanel Spacing="12">
        <phone:AskList x:Name="Asks" />

        <TextBlock Margin="2,2,2,0" Style="{StaticResource BodyTextBlockStyle}" FontSize="13" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Snip on your PC, it's on your phone. Pin a photo on your phone, it's on your PC. Any network." />

        <controls:SwitchRow x:Name="OnSwitch" Title="Use on phone" />

        <phone:PhoneBodyView x:Name="Body" />

        <phone:DeviceList x:Name="Devices" />

        <TextBlock Text="Your board stays on this PC." Margin="2,0" Style="{StaticResource BodyTextBlockStyle}" FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</UserControl>
